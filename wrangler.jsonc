{
  "name": "blog-studio",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": { "PUBLISH_ALLOWED_REPOSITORY": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "blog-studio-config" }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
